engine-strict=true

# Electron Forge (`electron-forge start` / `package` / `make`) loads
# dependencies via plain `require()` against `node_modules/`. pnpm's
# default symlinked layout puts each dep under `node_modules/.pnpm/...`
# with a symlink at the top level, which Forge doesn't resolve.
# `node-linker=hoisted` flattens the store into the classic npm-style
# layout so Forge + electron-builder + better-sqlite3 / dugite / node-pty
# all find their native addons.
#
# Keep this line in .npmrc — removing it breaks `pnpm start` with
# "When using pnpm, `node-linker` must be set to \"hoisted\"".
node-linker=hoisted

# The postinstall-script allowlist for native modules + binary
# downloaders (better-sqlite3, electron, dugite, @vscode/ripgrep, …)
# lives in `package.json`'s `pnpm.onlyBuiltDependencies` field —
# .npmrc does not read array-form settings. Do not re-add it here.
