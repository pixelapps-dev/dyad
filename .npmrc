engine-strict=true

# Electron Forge (`electron-forge start` / `package` / `make`) loads
# dependencies via plain `require()` against `node_modules/`. pnpm's
# default symlinked layout puts each dep under `node_modules/.pnpm/...`
# with a symlink at the top level, which Forge doesn't resolve.
# `node-linker=hoisted` flattens the store into the classic npm-style
# layout so Forge + electron-builder + better-sqlite3 / dugite / node-pty
# all find their native addons.
#
# Keep this line in .npmrc — removing it breaks `pnpm start` with
# "When using pnpm, `node-linker` must be set to \"hoisted\"".
node-linker=hoisted

# Native modules and CLI-downloading packages need their postinstall
# scripts to run: better-sqlite3 + node-pty compile against Electron's
# ABI, dugite + @vscode/ripgrep + electron + esbuild + sharp pull
# platform binaries. pnpm blocks postinstalls by default (supply-chain
# mitigation); we allowlist exactly the ones we need so the rest of
# the ecosystem stays locked down.
onlyBuiltDependencies[]=@biomejs/biome
onlyBuiltDependencies[]=@vscode/ripgrep
onlyBuiltDependencies[]=better-sqlite3
onlyBuiltDependencies[]=core-js
onlyBuiltDependencies[]=dugite
onlyBuiltDependencies[]=electron
onlyBuiltDependencies[]=electron-winstaller
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=node-pty
onlyBuiltDependencies[]=protobufjs
onlyBuiltDependencies[]=sharp
